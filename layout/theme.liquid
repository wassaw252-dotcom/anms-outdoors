<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title | escape }}</title>
<link rel="canonical" href="{{ canonical_url }}">
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<meta name="theme-color" content="#08140e">
{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ 'claude-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'theme.js' | asset_url }}" defer></script>
<script src="{{ 'claude-motion.js' | asset_url }}" defer></script>
<script id="ThemeStrings" type="application/json">{% assign string_keys = 'error,added,updated,saved,removed,storage,loading,cart_error,sound_on,sound_off,sound_error,unavailable,remove,retry,saved_error' | split: ',' %}{ {% for key in string_keys %}{% assign locale_key = 'js.' | append: key %}{{ key | json }}:{{ locale_key | t | json }}{% unless forloop.last %},{% endunless %}{% endfor %} }</script>
{{ content_for_header }}
</head>
<body class="page-{{ request.page_type }}" data-root="{{ routes.root_url }}">
<a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
{% section 'header' %}
<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
{% section 'footer' %}
{% section 'cart-drawer' %}
{% render 'utility-dialogs' %}
<p id="StoreStatus" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
</body>
</html>
