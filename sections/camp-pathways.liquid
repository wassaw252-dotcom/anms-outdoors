{% assign camp_url = collections['camp-sets'].url %}
{% assign camp_images = 'https://cdn.shopify.com/s/files/1/0968/1128/6825/files/anm-camp-set-solo.webp?v=1789351320,https://cdn.shopify.com/s/files/1/0968/1128/6825/files/anm-camp-set-couple.webp?v=1789351331,https://cdn.shopify.com/s/files/1/0968/1128/6825/files/anm-camp-set-family.webp?v=1789351342,https://cdn.shopify.com/s/files/1/0968/1128/6825/files/anm-camp-set-premium.webp?v=1789351361' | split: ',' %}
<section class="section camp-pathways" aria-labelledby="CampTitle"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">{{ 'camp.eyebrow' | t }}</span><h2 id="CampTitle">{{ 'nav.camp_sets' | t }}</h2><p class="muted">{{ 'camp.copy' | t }}</p></div>{% if camp_url != blank %}<a class="text-link" href="{{ camp_url }}">{{ 'camp.explore' | t }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div><div class="pathway-grid">
{% for block in section.blocks %}{% if camp_url != blank %}<a class="pathway" href="{{ camp_url }}" {{ block.shopify_attributes }}>{% else %}<article class="pathway" {{ block.shopify_attributes }}>{% endif %}
<img class="cover" src="{{ camp_images[forloop.index0] }}" width="1000" height="1500" alt="{{ block.settings.title | escape }}" loading="lazy">
<span class="pathway-number">0{{ forloop.index }}</span><div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.caption | escape }}</p></div>{% if camp_url != blank %}{% render 'icon', name: 'arrow' %}</a>{% else %}</article>{% endif %}{% endfor %}
</div><p class="small muted">{{ 'camp.note' | t }}{% if camp_url == blank %} {{ 'camp.unavailable' | t }}{% endif %}</p></div></section>
{% schema %}
{"name":"Camp pathways","max_blocks":4,"settings":[],"blocks":[{"type":"pathway","name":"Adventure pathway","settings":[{"type":"text","id":"title","label":"Title","default":"Family Adventure"},{"type":"text","id":"caption","label":"Caption","default":"Make more memories."},{"type":"image_picker","id":"image","label":"Atmosphere image"}]}],"presets":[{"name":"Camp pathways","blocks":[{"type":"pathway","settings":{"title":"Solo Explorer","caption":"A little space. A new perspective."}},{"type":"pathway","settings":{"title":"Couple Escape","caption":"Somewhere quieter, together."}},{"type":"pathway","settings":{"title":"Family Adventure","caption":"Make more memories."}},{"type":"pathway","settings":{"title":"Premium Basecamp","caption":"Settle in. Stay a little longer."}}]}]}
{% endschema %}
