<section class="section camp-pathways" aria-labelledby="CampTitle"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">{{ 'camp.eyebrow' | t }}</span><h2 id="CampTitle">{{ 'nav.camp_sets' | t }}</h2><p class="muted">{{ 'camp.copy' | t }}</p></div><a class="text-link" href="{{ collections['camp-sets'].url }}">{{ 'camp.explore' | t }} {% render 'icon', name: 'arrow' %}</a></div><div class="pathway-grid">
{% for block in section.blocks %}<a class="pathway" href="{{ collections['camp-sets'].url }}" {{ block.shopify_attributes }}>
{% if block.settings.image %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 540, 800', sizes: '(min-width: 990px) 24vw, 46vw', class: 'cover' }}{% else %}<img class="cover" src="{{ 'anm-campsite.jpg' | asset_url }}" width="1536" height="1024" alt="" loading="lazy">{% endif %}
<span class="pathway-number">0{{ forloop.index }}</span><div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.caption | escape }}</p></div>{% render 'icon', name: 'arrow' %}</a>{% endfor %}
</div><p class="small muted">{{ 'camp.note' | t }}</p></div></section>
{% schema %}
{"name":"Camp pathways","max_blocks":4,"settings":[],"blocks":[{"type":"pathway","name":"Adventure pathway","settings":[{"type":"text","id":"title","label":"Title","default":"Family Adventure"},{"type":"text","id":"caption","label":"Caption","default":"Make more memories."},{"type":"image_picker","id":"image","label":"Atmosphere image"}]}],"presets":[{"name":"Camp pathways","blocks":[{"type":"pathway","settings":{"title":"Solo Explorer","caption":"A little space. A new perspective."}},{"type":"pathway","settings":{"title":"Couple Escape","caption":"Somewhere quieter, together."}},{"type":"pathway","settings":{"title":"Family Adventure","caption":"Make more memories."}},{"type":"pathway","settings":{"title":"Premium Basecamp","caption":"Settle in. Stay a little longer."}}]}]}
{% endschema %}
