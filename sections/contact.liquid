<section class="section wrap narrow"><span class="eyebrow">{{ 'support.heading' | t }}</span><h1>{{ 'nav.contact' | t }}</h1><p class="muted">{{ 'contact.copy' | t }}</p>{% form 'contact', id: 'ContactForm' %}{% if form.posted_successfully? %}<p role="status">{{ 'contact.success' | t }}</p>{% endif %}{% if form.errors %}<div class="form-error" role="alert" tabindex="-1" data-error-summary>{{ form.errors | default_errors }}</div>{% endif %}<label for="ContactName">{{ 'contact.name' | t }}</label><input id="ContactName" name="contact[name]" type="text" autocomplete="name" value="{{ form.name | default: customer.name | escape }}"><label for="ContactEmail">{{ 'newsletter.email' | t }}</label><input id="ContactEmail" name="contact[email]" type="email" autocomplete="email" value="{{ form.email | default: customer.email | escape }}" required {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="ContactEmailError"{% endif %}>{% if form.errors contains 'email' %}<p id="ContactEmailError" class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{% endif %}<label for="ContactMessage">{{ 'contact.message' | t }}</label><textarea id="ContactMessage" name="contact[body]" rows="7" required>{{ form.body | escape }}</textarea><button class="button" type="submit">{{ 'contact.send' | t }} {% render 'icon', name: 'arrow' %}</button>{% endform %}</section>
{% schema %}
{"name":"Contact form","settings":[]}
{% endschema %}
