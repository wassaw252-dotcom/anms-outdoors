{% assign editorial_kind = section.settings.kind %}
<section class="editorial-hero"><img class="cover" src="{{ 'anm-campsite.jpg' | asset_url }}" width="1536" height="1024" alt="{{ 'brand.hero_alt' | t }}" fetchpriority="high"><div class="wrap"><span class="eyebrow">{% if editorial_kind == 'about' %}{{ 'bootstrap.brand' | t }}{% else %}{{ 'explore.eyebrow' | t }}{% endif %}</span><h1>{% if editorial_kind == 'about' %}{{ 'home.connection' | t }}{% else %}{{ 'explore.heading' | t }}{% endif %}</h1><p>{% if editorial_kind == 'about' %}{{ 'bootstrap.tagline' | t }}{% else %}{{ 'explore.intro' | t }}{% endif %}</p></div></section>
{% if editorial_kind == 'about' %}<section class="section cream"><div class="wrap editorial-columns"><div><span class="eyebrow">{{ 'brand.more' | t }}</span><h2>{{ 'about.heading' | t }}</h2></div><div class="richtext"><p>{{ 'home.connection_copy' | t }}</p><p>{{ 'about.copy' | t }}</p><p>{{ 'about.values' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'home.shop_all' | t }} {% render 'icon', name: 'arrow' %}</a></div></div></section>{% else %}<section class="section cream"><div class="wrap"><div class="editorial-intro"><p class="eyebrow">{{ 'explore.start' | t }}</p><h2>{{ 'explore.small' | t }}</h2></div><div class="guide-grid">{% assign topics = 'camping,family,gear,setup,stories' | split: ',' %}{% for topic in topics %}{% assign title_key = 'explore.' | append: topic %}{% assign copy_key = title_key | append: '_copy' %}<article id="{{ topic }}" class="guide"><span class="eyebrow">0{{ forloop.index }}</span><h3>{{ title_key | t }}</h3><p>{{ copy_key | t }}</p></article>{% endfor %}</div><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'home.shop_all' | t }} {% render 'icon', name: 'arrow' %}</a></div></section>{% endif %}
{% schema %}
{"name":"Editorial page","settings":[{"type":"select","id":"kind","label":"Page content","options":[{"value":"about","label":"About"},{"value":"explore","label":"Explore"}],"default":"about"}]}
{% endschema %}
