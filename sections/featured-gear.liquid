{% assign featured = section.settings.collection | default: collections['all-gear'] %}
<section class="section cream featured" aria-labelledby="Featured-{{ section.id }}"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">{{ 'home.for_next' | t }}</span><h2 id="Featured-{{ section.id }}">{{ section.settings.heading | default: 'Featured Gear' | escape }}</h2></div>{% if featured.url != blank %}<a class="text-link" href="{{ featured.url }}">{{ 'general.view_all' | t }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div>
<div class="product-grid">{% for product in featured.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}<div class="empty-state"><span class="eyebrow">{{ 'home.room' | t }}</span><h3>{{ 'shop.empty_heading' | t }}</h3><p>{{ 'shop.empty_copy' | t }}</p><a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'shop.browse' | t }} {% render 'icon', name: 'arrow' %}</a></div>{% endfor %}</div></div></section>
{% schema %}
{"name":"Featured gear","settings":[{"type":"text","id":"heading","label":"Heading","default":"Featured Gear"},{"type":"collection","id":"collection","label":"Real product collection"},{"type":"range","id":"limit","label":"Maximum products","min":4,"max":12,"step":4,"default":4}],"presets":[{"name":"Featured gear"}]}
{% endschema %}
