<section class="trust-strip wrap" aria-label="{{ 'support.heading' | t }}"><div>{% render 'icon', name: 'shield' %}<span>{{ 'support.checkout' | t }}<small>{{ 'support.checkout_copy' | t }}</small></span></div><div>{% render 'icon', name: 'truck' %}<span>{{ 'support.shipping' | t }}<small>{{ 'support.shipping_copy' | t }}</small></span></div><a href="{{ pages.contact.url }}">{% render 'icon', name: 'mail' %}<span>{{ 'support.contact' | t }}<small>{{ 'support.contact_copy' | t }}</small></span></a></section>
<footer class="footer"><div class="wrap"><div class="footer-top"><div class="newsletter"><span class="eyebrow">{{ 'newsletter.eyebrow' | t }}</span><h2>{{ 'newsletter.heading' | t }}</h2><p>{{ 'newsletter.copy' | t }}</p>{% form 'customer', id: 'NewsletterForm' %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="NewsletterEmail">{{ 'newsletter.email' | t }}</label><div class="newsletter-row"><input type="email" id="NewsletterEmail" name="contact[email]" autocomplete="email" required {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterErrors"{% endif %}><button class="button" type="submit">{{ 'newsletter.submit' | t }} {% render 'icon', name: 'arrow' %}</button></div>{% if form.posted_successfully? %}<p role="status">{{ 'newsletter.success' | t }}</p>{% endif %}<div id="NewsletterErrors" class="form-error">{{ form.errors | default_errors }}</div>{% endform %}</div><nav class="footer-links" aria-label="{{ 'nav.footer' | t }}"><div><h3>{{ 'nav.shop' | t }}</h3><a href="{{ collections['all-gear'].url | default: routes.all_products_collection_url }}">{{ 'nav.all_gear' | t }}</a><a href="{{ collections['camp-sets'].url }}">{{ 'nav.camp_sets' | t }}</a><a href="{{ routes.root_url }}?view=saved">{{ 'nav.saved' | t }}</a></div><div><h3>{{ 'nav.discover' | t }}</h3><a href="{{ routes.root_url }}?view=explore">{{ 'nav.explore' | t }}</a><a href="{{ routes.root_url }}?view=about">{{ 'nav.about' | t }}</a><a href="{{ pages.contact.url }}">{{ 'nav.contact' | t }}</a><a href="{{ routes.account_url }}">{{ 'nav.account' | t }}</a></div></nav></div>
<div class="footer-brand"><p class="editorial-note">{{ 'footer.quote' | t }}</p><a class="brand" href="{{ routes.root_url }}">{% render 'logo' %}</a><p class="eyebrow">{{ 'bootstrap.tagline' | t }}</p></div>
<div class="footer-bottom"><small>© {{ 'now' | date: '%Y' }} ANM’s OUTDOORS</small><div>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</div><small>{{ localization.country.name }} · {{ cart.currency.iso_code }}</small></div></div></footer>
{% schema %}
{"name":"Brand footer","settings":[]}
{% endschema %}
