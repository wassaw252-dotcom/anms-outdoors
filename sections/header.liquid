<header class="header">
<div class="header-inner wrap">
<a class="brand" href="{{ routes.root_url }}" aria-label="{{ 'nav.home' | t }}">{% render 'logo' %}</a>
<nav class="desktop-nav" aria-label="{{ 'nav.main' | t }}">
<details class="mega" data-mega><summary>{{ 'nav.shop' | t }}</summary>
<div class="mega-panel"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">{{ 'brand.more' | t }}</span><h2>{{ 'shop.heading' | t }}</h2></div><a class="text-link" href="{{ collections['all-gear'].url | default: routes.all_products_collection_url }}">{{ 'nav.all_gear' | t }} {% render 'icon', name: 'arrow' %}</a></div>{% render 'categories', mode: 'mega' %}</div></div>
</details>
<a href="{{ routes.root_url }}?view=explore">{{ 'nav.explore' | t }}</a><a href="{{ routes.root_url }}?view=about">{{ 'nav.about' | t }}</a>
</nav>
<div class="header-actions">
<a class="icon-button" href="{{ routes.search_url }}" data-open="SearchDialog" aria-label="{{ 'nav.search' | t }}">{% render 'icon', name: 'search' %}</a>
<a class="icon-button account-link" href="{{ routes.account_url }}" aria-label="{{ 'nav.account' | t }}">{% render 'icon', name: 'user' %}</a>
<a class="icon-button cart-link" href="{{ routes.cart_url }}" data-open="CartDialog" aria-label="{{ 'cart.title' | t }}">{% render 'icon', name: 'cart' %}<span class="cart-count" data-cart-count>{{ cart.item_count }}</span></a>
<button class="icon-button mobile-toggle" data-open="MobileMenu" aria-label="{{ 'nav.open_menu' | t }}">{% render 'icon', name: 'menu' %}</button>
</div></div>
</header>
<dialog id="MobileMenu" class="drawer menu-drawer" aria-labelledby="MobileMenuTitle">
<div class="drawer-heading"><h2 id="MobileMenuTitle" class="sr-only">{{ 'nav.main' | t }}</h2><a class="brand" href="{{ routes.root_url }}">{% render 'logo' %}</a><button class="icon-button" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></div>
<div class="drawer-body">
{% render 'search-form', form_id: 'MobileSearch' %}
{% render 'categories', mode: 'menu' %}
<a class="button full" href="{{ collections['all-gear'].url | default: routes.all_products_collection_url }}">{{ 'nav.all_gear' | t }} {% render 'icon', name: 'arrow' %}</a>
<nav class="mobile-links" aria-label="{{ 'nav.main' | t }}"><a href="{{ routes.root_url }}">{{ 'nav.home' | t }}</a><a href="{{ routes.root_url }}?view=explore">{{ 'nav.explore' | t }}</a><a href="{{ routes.root_url }}?view=about">{{ 'nav.about' | t }}</a><a href="{{ pages.contact.url }}">{{ 'nav.contact' | t }}</a><a href="{{ routes.account_url }}">{{ 'nav.account' | t }}</a><a href="{{ routes.root_url }}?view=saved">{{ 'nav.saved' | t }}</a></nav>
<p class="editorial-note">{{ 'brand.memories' | t }}</p>
</div></dialog>
<noscript><nav class="wrap nojs-nav"><a href="{{ routes.all_products_collection_url }}">{{ 'nav.shop' | t }}</a><a href="{{ routes.root_url }}?view=explore">{{ 'nav.explore' | t }}</a><a href="{{ routes.root_url }}?view=about">{{ 'nav.about' | t }}</a></nav></noscript>
{% schema %}
{"name":"Brand header","settings":[]}
{% endschema %}
