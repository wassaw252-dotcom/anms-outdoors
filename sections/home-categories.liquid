{{ 'shop-by-adventure.css' | asset_url | stylesheet_tag }}
{% liquid
  assign category_handles = 'tents-shelters,furniture-comfort,sleeping-relaxation,lighting-power,camp-kitchen-dining,hydration-outdoor-living,gear-essentials,camp-sets,all' | split: ','
  assign category_labels = 'Tents & Shelters|Furniture & Comfort|Sleeping & Relaxation|Lighting & Power|Camp Kitchen & Dining|Hydration & Outdoor Living|Gear & Essentials|Camp Sets|All Gear' | split: '|'
  assign category_icons = 'tent,chair,sleep,lantern,pot,bottle,pack,tent,pack' | split: ','
  assign tent_featured_handles = 'camel-giant-cabin-tent-two-bedrooms-and-living-room,keephike-portable-tunnel-tent-210d-oxford-instant-pitch,keephike-ridge-cabin-tent-two-bedrooms-and-hall' | split: ','
  assign sba_background_url = 'https://cdn.shopify.com/s/files/1/0968/1128/6825/files/anm-camp-set-family.webp?v=1789351342'
  if section.settings.background_image != blank
    assign sba_background_url = section.settings.background_image | image_url: width: 2400
  endif
%}

<section id="ShopByAdventure-{{ section.id }}" class="section sba-section" style="--sba-scene:url('{{ sba_background_url }}')" aria-labelledby="ShopByAdventureTitle-{{ section.id }}">
  <div class="wrap">
    <div class="sba-heading">
      <span class="eyebrow">FIND YOUR NEXT ADVENTURE</span>
      <h2 id="ShopByAdventureTitle-{{ section.id }}">{{ section.settings.heading | default: 'Shop by Adventure' | escape }}</h2>
      <p>{{ section.settings.subheading | default: 'Choose a category and discover our best picks.' | escape }}</p>
    </div>

    <div class="sba-controller">
      {% for category_handle in category_handles %}
        <input class="sba-choice" type="radio" name="sba-{{ section.id }}" id="SbaChoice-{{ section.id }}-{{ category_handle }}"{% if forloop.first %} checked{% endif %}>
      {% endfor %}

      <div class="sba-tabs" role="tablist" aria-label="Shop by Adventure categories">
        {% for category_handle in category_handles %}
          {% assign category_label = category_labels[forloop.index0] %}
          <label class="sba-tab sba-tab--{{ category_handle }}" for="SbaChoice-{{ section.id }}-{{ category_handle }}">
            <span class="sba-tab-icon" aria-hidden="true">{% render 'icon', name: category_icons[forloop.index0] %}</span>
            <span class="sba-tab-label">{{ category_label | escape }}</span>
          </label>
        {% endfor %}
      </div>

      <div class="sba-panels">
        {% for category_handle in category_handles %}
          {% assign category = collections[category_handle] %}
          {% assign category_label = category_labels[forloop.index0] %}
          {% if category_handle == 'all' %}
            {% assign category_url = routes.all_products_collection_url %}
          {% elsif category != blank %}
            {% assign category_url = category.url %}
          {% else %}
            {% assign category_url = routes.collections_url | append: '/' | append: category_handle %}
          {% endif %}
          {% if category_handle == 'tents-shelters' %}
            {% assign loop_count = 3 %}
          {% else %}
            {% assign loop_count = category.products_count %}
            {% if loop_count > 5 %}{% assign loop_count = 5 %}{% endif %}
          {% endif %}
          {% assign loop_enabled = false %}
          {% if loop_count > 1 %}{% assign loop_enabled = true %}{% endif %}

          <div class="sba-panel sba-panel--{{ category_handle }}">
            <div class="sba-panel-head">
              <div>
                <span class="sba-panel-kicker">SHOP BY ADVENTURE</span>
                <h3>{{ category_label | escape }}</h3>
                <p>Featured picks for your next adventure.</p>
              </div>
              <a class="sba-view-all" href="{{ category_url }}">View all</a>
            </div>

            {% if category_handle == 'tents-shelters' or category.products_count > 0 %}
              <div class="sba-viewport"{% if loop_enabled %} data-sba-loop data-count="{{ loop_count }}"{% endif %}>
                <div class="sba-track">
                  {% if category_handle == 'tents-shelters' %}
                    {% if loop_enabled %}
                      {% for product_handle in tent_featured_handles %}
                        {% assign product = all_products[product_handle] %}
                        {% if product != blank %}{% render 'adventure-product-card', product: product, clone: true %}{% endif %}
                      {% endfor %}
                    {% endif %}
                    {% for product_handle in tent_featured_handles %}
                      {% assign product = all_products[product_handle] %}
                      {% if product != blank %}{% render 'adventure-product-card', product: product %}{% endif %}
                    {% endfor %}
                    {% if loop_enabled %}
                      {% for product_handle in tent_featured_handles %}
                        {% assign product = all_products[product_handle] %}
                        {% if product != blank %}{% render 'adventure-product-card', product: product, clone: true %}{% endif %}
                      {% endfor %}
                    {% endif %}
                  {% else %}
                    {% if loop_enabled %}
                      {% for product in category.products limit: 5 %}{% render 'adventure-product-card', product: product, clone: true %}{% endfor %}
                    {% endif %}
                    {% for product in category.products limit: 5 %}{% render 'adventure-product-card', product: product %}{% endfor %}
                    {% if loop_enabled %}
                      {% for product in category.products limit: 5 %}{% render 'adventure-product-card', product: product, clone: true %}{% endfor %}
                    {% endif %}
                  {% endif %}
                </div>
              </div>
              <div class="sba-swipe-hint" aria-hidden="true">
                <span>↔</span> Swipe products <span class="sba-hint-dot">•</span> Scroll page <span>↓</span>
              </div>
            {% else %}
              <div class="sba-empty"><span class="eyebrow">COMING SOON</span><h4>More gear is on the way.</h4><p>This category will automatically show its featured products here once products are added.</p></div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="sba-why">
    <div class="wrap sba-why-wrap">
      <div class="sba-why-head">
        <span class="sba-why-eyebrow">OUR PURPOSE</span>
        <h2>Why ANM’s OUTDOORS</h2>
        <p>We’re not just here to sell gear — we’re here to inspire your next escape.</p>
      </div>

      <div class="sba-why-grid">
        <article class="sba-why-card">
          <span class="sba-why-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none"><path d="M24 4 39 10v11c0 10-6.2 17.7-15 23-8.8-5.3-15-13-15-23V10L24 4Z" stroke="currentColor" stroke-width="2.5"/><path d="m17 24 5 5 10-12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <div><h3>Trusted Outdoor Gear</h3><p>Carefully selected products for camping, comfort and outdoor living.</p></div>
        </article>

        <article class="sba-why-card">
          <span class="sba-why-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none"><circle cx="18" cy="17" r="6" stroke="currentColor" stroke-width="2.5"/><circle cx="32" cy="18" r="5" stroke="currentColor" stroke-width="2.5"/><path d="M7 39v-5c0-6 4.5-10 11-10s11 4 11 10v5M28 27c7 0 12 3.6 12 9v3" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          </span>
          <div><h3>Made for Real Moments</h3><p>From family cookouts to quiet lakeside mornings — every trip tells a story.</p></div>
        </article>

        <article class="sba-why-card">
          <span class="sba-why-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none"><path d="m5 39 13-21 7 10 5-8 13 19H5Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="m17 39 8-11 6 11" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></svg>
          </span>
          <div><h3>Adventure Starts Here</h3><p>Discover simple ways to spend more time outside and less time overthinking.</p></div>
        </article>

        <article class="sba-why-card sba-why-card--challenge">
          <span class="sba-prize-badge">WIN RM5,000</span>
          <span class="sba-why-icon sba-why-icon--gold" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none"><path d="M15 7h18v8c0 8-3.8 14-9 14s-9-6-9-14V7Z" stroke="currentColor" stroke-width="2.5"/><path d="M15 11H8v4c0 6 3.7 9 9 9M33 11h7v4c0 6-3.7 9-9 9M24 29v7M16 41h16M19 36h10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          </span>
          <div>
            <h3>Join &amp; Win RM5,000</h3>
            <p>Spend RM299, create your camping video, and stand a chance to win the grand prize.</p>
            {% if section.settings.challenge_url != blank %}
              <a class="sba-why-cta" href="{{ section.settings.challenge_url }}">How to Join</a>
            {% else %}
              <span class="sba-why-cta sba-why-cta--disabled">How to Join</span>
            {% endif %}
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
{% for category_handle in category_handles %}
#SbaChoice-{{ section.id }}-{{ category_handle }}:checked ~ .sba-tabs .sba-tab--{{ category_handle }}::after{background:#d2ad61;transform:scaleX(1)}
#SbaChoice-{{ section.id }}-{{ category_handle }}:checked ~ .sba-tabs .sba-tab--{{ category_handle }} .sba-tab-icon{background:#e9dfc7;color:#24351f;border-color:#e9dfc7;transform:translateY(-2px)}
#SbaChoice-{{ section.id }}-{{ category_handle }}:checked ~ .sba-panels .sba-panel--{{ category_handle }}{display:block}
{% endfor %}
</style>

<script>
(() => {
  const root = document.getElementById('ShopByAdventure-{{ section.id }}');
  if (!root || root.dataset.sbaReady === 'true') return;
  root.dataset.sbaReady = 'true';
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const initViewport = (viewport) => {
    if (!viewport || viewport.dataset.loopReady === 'true' || viewport.offsetWidth === 0) return;
    const track = viewport.querySelector('.sba-track');
    const count = Number(viewport.dataset.count || 0);
    const cards = track ? Array.from(track.children) : [];
    if (!track || count < 2 || cards.length < count * 3) return;

    const step = () => cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : 0;
    const setWidth = () => step() * count;
    const jumpTo = (left) => {
      const previous = viewport.style.scrollBehavior;
      viewport.style.scrollBehavior = 'auto';
      viewport.scrollLeft = left;
      viewport.offsetHeight;
      viewport.style.scrollBehavior = previous;
    };
    const center = () => {
      const width = setWidth();
      if (width > 0) jumpTo(width);
    };
    const normalize = () => {
      const s = step();
      const width = s * count;
      if (!width) return;
      if (viewport.scrollLeft < s * 0.75) jumpTo(viewport.scrollLeft + width);
      else if (viewport.scrollLeft >= width * 2) jumpTo(viewport.scrollLeft - width);
    };

    let timer = null;
    let scrollTimer = null;
    let resumeTimer = null;
    let interacting = false;

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };
    const start = () => {
      stop();
      if (reduceMotion.matches || interacting) return;
      timer = setInterval(() => {
        normalize();
        const s = step();
        if (s) viewport.scrollBy({ left: s, behavior: 'smooth' });
      }, 2000);
    };
    const pause = () => {
      interacting = true;
      clearTimeout(resumeTimer);
      stop();
    };
    const resume = () => {
      interacting = false;
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => {
        normalize();
        start();
      }, 2000);
    };
    const softPause = () => {
      stop();
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(start, 2000);
    };

    viewport.addEventListener('pointerdown', pause, { passive: true });
    viewport.addEventListener('pointerup', resume, { passive: true });
    viewport.addEventListener('pointercancel', resume, { passive: true });
    viewport.addEventListener('mouseleave', () => { if (interacting) resume(); });
    viewport.addEventListener('wheel', softPause, { passive: true });
    viewport.addEventListener('scroll', () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(normalize, 140);
    }, { passive: true });
    window.addEventListener('resize', () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(center, 140);
    });
    if (reduceMotion.addEventListener) reduceMotion.addEventListener('change', start);

    viewport.dataset.loopReady = 'true';
    center();
    start();
  };

  const initVisible = () => {
    root.querySelectorAll('.sba-panel').forEach((panel) => {
      if (panel.offsetParent !== null) initViewport(panel.querySelector('[data-sba-loop]'));
    });
  };

  root.querySelectorAll('.sba-choice').forEach((choice) => {
    choice.addEventListener('change', () => requestAnimationFrame(initVisible));
  });
  requestAnimationFrame(initVisible);
})();
</script>

{% schema %}
{
  "name": "Shop by adventure",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Shop by Adventure"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Choose a category and discover our best picks."},
    {"type":"image_picker","id":"background_image","label":"Cinematic background image"},
    {"type":"url","id":"challenge_url","label":"Challenge page link"}
  ],
  "presets": [{"name":"Shop by adventure"}]
}
{% endschema %}