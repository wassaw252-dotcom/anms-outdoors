{{ 'home-journey.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home-journey.js' | asset_url }}" defer></script>
{% if section.settings.image %}<style>:root{--anm-journey-bg:url('{{ section.settings.image | image_url: width: 2400 }}')}</style>{% endif %}
<section id="StoreStart" class="story-banner story-banner--journey" tabindex="-1" aria-labelledby="StoryTitle">
  <div class="wrap story-content">
    <span class="eyebrow">CHASE LESS NOISE.</span>
    <h2 id="StoryTitle">FIND MORE LIFE.</h2>
    <p>For the weekends that bring us together, and the quiet moments that stay with us.</p>
    <a class="button" href="{{ collections['all-gear'].url | default: routes.all_products_collection_url }}">{{ 'home.shop_all' | t }} {% render 'icon', name: 'arrow' %}</a>
  </div>
  <p class="story-aside">{{ 'home.same_trails' | t }}</p>
</section>
{% schema %}
{"name":"Brighter tomorrow","settings":[{"type":"image_picker","id":"image","label":"Static journey background"}],"presets":[{"name":"Brighter tomorrow"}]}
{% endschema %}
