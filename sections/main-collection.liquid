<section class="collection-hero"><img class="cover" src="{{ 'anm-campsite.jpg' | asset_url }}" width="1536" height="1024" alt="" fetchpriority="high"><div class="wrap"><p class="breadcrumb"><a href="{{ routes.root_url }}">{{ 'nav.home' | t }}</a> / {{ 'nav.shop' | t }}</p><span class="eyebrow">{{ 'shop.eyebrow' | t }}</span><h1>{% if collection.handle == 'all' or collection.handle == 'all-gear' %}{{ 'shop.heading' | t }}{% else %}{{ collection.title | escape }}{% endif %}</h1><div class="richtext">{% if collection.description != blank %}{{ collection.description }}{% else %}<p>{{ 'shop.copy' | t }}</p>{% endif %}</div></div></section>
<div class="wrap collection-categories">{% render 'categories', mode: 'compact' %}</div>
<nav class="shop-tabs wrap" aria-label="{{ 'shop.collections' | t }}">{% assign tab_handles = 'all-gear,best-sellers,new-arrivals,camp-sets' | split: ',' %}{% for tab_handle in tab_handles %}{% assign tab_collection = collections[tab_handle] %}{% if tab_collection.url != blank %}<a class="pill {% if collection.handle == tab_handle %}selected{% endif %}" href="{{ tab_collection.url }}" {% if collection.handle == tab_handle %}aria-current="page"{% endif %}>{{ tab_collection.title | escape }}</a>{% elsif tab_handle == 'all-gear' %}<a class="pill {% if collection.handle == 'all' %}selected{% endif %}" href="{{ routes.all_products_collection_url }}" {% if collection.handle == 'all' %}aria-current="page"{% endif %}>{{ 'nav.all_gear' | t }}</a>{% endif %}{% endfor %}</nav>
<section class="section collection-main wrap">
{% paginate collection.products by section.settings.page_size %}
<div class="collection-toolbar"><p>{{ 'shop.count' | t: count: collection.products_count }}</p><button class="button secondary filter-open" data-open="FilterDialog">{% render 'icon', name: 'filter' %} {{ 'shop.filter_sort' | t }}</button></div>
<div class="collection-layout"><aside class="desktop-filters">{% render 'filters', form_id: 'DesktopFilters' %}</aside><div><div class="active-filters">{% for filter in collection.filters %}{% for value in filter.active_values %}<a class="pill" href="{{ value.url_to_remove }}">{{ value.label | escape }} <span aria-hidden="true">×</span><span class="sr-only">{{ 'general.remove' | t }}</span></a>{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value != nil or filter.max_value.value != nil %}<a class="pill" href="{{ filter.url_to_remove }}">{{ filter.label | escape }} ×</a>{% endif %}{% endif %}{% endfor %}</div>
<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<div class="empty-state"><span class="eyebrow">{{ 'brand.more' | t }}</span><h2>{{ 'shop.empty_heading' | t }}</h2><p>{{ 'shop.empty_copy' | t }}</p><a class="button secondary" href="{{ collection.url }}">{{ 'shop.reset' | t }}</a><a class="text-link" href="{{ routes.root_url }}?view=explore">{{ 'explore.heading' | t }} {% render 'icon', name: 'arrow' %}</a></div>{% endfor %}</div>
{% if paginate.pages > 1 %}<nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>{% endif %}</div></div>
{% endpaginate %}
</section>
<dialog id="FilterDialog" class="drawer filter-drawer" aria-labelledby="FilterTitle"><div class="drawer-heading"><h2 id="FilterTitle">{{ 'shop.filter_sort' | t }}</h2><button class="icon-button" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></div><div class="drawer-body">{% render 'filters', form_id: 'MobileFilters' %}</div></dialog>
{% schema %}
{"name":"Collection","settings":[{"type":"range","id":"page_size","label":"Products per page","min":12,"max":36,"step":4,"default":24}]}
{% endschema %}
