{% if page.handle == 'anms-outdoors-challenge' %}
  {{ 'challenge-experience.css' | asset_url | stylesheet_tag }}

  <div id="NxcChallenge" class="nxc">
    <section class="nxc-hero" aria-labelledby="NxcChallengeTitle">
      <div class="nxc-hero__media" style="background-image:url('{{ 'anm-campsite.jpg' | asset_url }}')" aria-hidden="true"></div>
      <div class="nxc-hero__shade" aria-hidden="true"></div>
      <div class="nxc-grain" aria-hidden="true"></div>

      <div class="nxc-wrap nxc-hero__content">
        <img
          class="nxc-brand-lockup"
          src="https://cdn.shopify.com/s/files/1/0968/1128/6825/files/anms-built-for-the-wild-lockup.png?v=1789521820"
          alt="Your Next Escape Starts Here. Built for the Wild."
          width="1448"
          height="1086"
          data-nxc-reveal
        >

        <img
          class="nxc-lockup"
          src="https://cdn.shopify.com/s/files/1/0968/1128/6825/files/anms-challenge-reference-lockup.png?v=1789518419"
          alt="Challenge — RM5,000 Grand Prize"
          id="NxcChallengeTitle"
          width="1536"
          height="469"
          data-nxc-reveal
        >

        <p class="nxc-hero__tagline" data-nxc-reveal>SHARE YOUR ADVENTURE. WIN RM5,000.</p>

        <div class="nxc-countdown" data-nxc-countdown role="timer" aria-label="45 days 0 hours 0 minutes remaining" data-nxc-reveal>
          <span class="nxc-countdown__calendar" aria-hidden="true">
            <svg viewBox="0 0 32 32"><rect x="4" y="7" width="24" height="21" rx="3"/><path d="M9 3v8M23 3v8M4 13h24M9 18h4M16 18h4M9 23h4M16 23h4"/></svg>
          </span>
          <span class="nxc-countdown__unit"><strong data-nxc-days>45</strong><small>DAYS</small></span>
          <span class="nxc-countdown__sep">:</span>
          <span class="nxc-countdown__unit"><strong data-nxc-hours>00</strong><small>HOURS</small></span>
          <span class="nxc-countdown__sep">:</span>
          <span class="nxc-countdown__unit"><strong data-nxc-minutes>00</strong><small>MINUTES</small></span>
        </div>

        <div class="nxc-entrychoices" aria-label="Ways to enter" data-nxc-reveal>
          <div class="nxc-entrychoice">
            <span class="nxc-entrychoice__icon" aria-hidden="true">
              <svg viewBox="0 0 32 32"><path d="M4 12 15 5h11l2 3v9L17 28 4 15v-3Z"/><circle cx="23" cy="10" r="2"/></svg>
            </span>
            <strong>RM150</strong>
            <small>ENTRY FEE</small>
          </div>
          <span class="nxc-entrychoices__or">OR</span>
          <div class="nxc-entrychoice">
            <span class="nxc-entrychoice__icon" aria-hidden="true">
              <svg viewBox="0 0 32 32"><path d="M3 5h4l3 16h14l3-11H9M13 27h.01M23 27h.01"/></svg>
            </span>
            <small class="nxc-entrychoice__top">BUY GEAR</small>
            <strong>RM299+</strong>
            <small>AUTOMATIC ENTRY</small>
          </div>
        </div>

        <a class="nxc-btn nxc-btn--gold nxc-hero__cta" href="#nxc-entry" data-nxc-reveal>ACCEPT THE CHALLENGE <span>→</span></a>
      </div>
    </section>

    <main class="nxc-main">
      <section id="nxc-story" class="nxc-story nxc-wrap nxc-section">
        <div class="nxc-story__copy" data-nxc-reveal>
          <p class="nxc-kicker">REAL PEOPLE. REAL PLACES. REAL STORIES.</p>
          <h2>Your Adventure.<br>Our Story.</h2>
          <p class="nxc-copy">ANM’s OUTDOORS Challenge is about celebrating the outdoors — the moments that move us, the memories we keep and the stories that make someone else want to step outside.</p>
          <div class="nxc-story__note">Made outside.<br>Remembered forever.</div>
        </div>
        <div class="nxc-story__image nxc-media-card" data-nxc-reveal style="background-image:linear-gradient(180deg,transparent,rgba(3,14,10,.28)),url('{{ 'anm-category-gear.webp' | asset_url }}')">
          <span>GOOD PEOPLE<br>WILD PLACES<br>BETTER STORIES</span>
        </div>
      </section>

      <section class="nxc-steps nxc-section">
        <div class="nxc-wrap">
          <div class="nxc-sectionhead" data-nxc-reveal>
            <p class="nxc-kicker">HOW IT WORKS</p>
            <h2>Four steps. One story.</h2>
          </div>
          <div class="nxc-steps__track" data-nxc-steps>
            <div class="nxc-steps__line"><span></span></div>
            <article class="nxc-step" data-nxc-reveal><b>01</b><strong>JOIN</strong><p>Choose your entry path.</p></article>
            <article class="nxc-step" data-nxc-reveal><b>02</b><strong>ADVENTURE</strong><p>Get outside and make it real.</p></article>
            <article class="nxc-step" data-nxc-reveal><b>03</b><strong>CREATE</strong><p>Shape the journey into a short story.</p></article>
            <article class="nxc-step" data-nxc-reveal><b>04</b><strong>WIN</strong><p>Stand a chance to win RM5,000.</p></article>
          </div>
        </div>
      </section>

      <section id="nxc-entry" class="nxc-entry nxc-wrap nxc-section">
        <div class="nxc-sectionhead" data-nxc-reveal>
          <p class="nxc-kicker">CHOOSE YOUR PATH</p>
          <h2>Same destination. Different way in.</h2>
        </div>
        <div class="nxc-entry__grid">
          <article class="nxc-entrycard" data-nxc-reveal style="--nxc-card:url('{{ 'anm-category-gear.webp' | asset_url }}')">
            <div class="nxc-entrycard__content">
              <span class="nxc-entrycard__type">ADVENTURE ENTRY</span>
              <h3>RM150</h3>
              <p>For outdoor explorers, storytellers and everyday adventurers who want to join directly.</p>
              <a href="#nxc-rules">VIEW ENTRY DETAILS <span>→</span></a>
            </div>
          </article>
          <article class="nxc-entrycard" data-nxc-reveal style="--nxc-card:url('{{ 'anm-category-tents.webp' | asset_url }}')">
            <div class="nxc-entrycard__content">
              <span class="nxc-entrycard__type">GEAR ENTRY</span>
              <h3>RM299+</h3>
              <p>Challenge entry is included with a qualifying ANM’s OUTDOORS gear purchase of RM299 or more.</p>
              <a href="/collections/all">SHOP GEAR <span>→</span></a>
            </div>
          </article>
        </div>
      </section>

      <section class="nxc-gallery nxc-section">
        <div class="nxc-wrap">
          <div class="nxc-gallery__head" data-nxc-reveal>
            <div><p class="nxc-kicker">CAPTURE THE JOURNEY</p><h2>Real Adventures. Real People.</h2></div>
            <span>SWIPE / EXPLORE →</span>
          </div>
          <div class="nxc-film" data-nxc-reveal>
            <div class="nxc-shot" style="background-image:url('{{ 'anm-category-gear.webp' | asset_url }}')"><span>HIKE</span></div>
            <div class="nxc-shot" style="background-image:url('{{ 'anm-category-tents.webp' | asset_url }}')"><span>CAMP</span></div>
            <div class="nxc-shot" style="background-image:url('{{ 'anm-category-kitchen.webp' | asset_url }}')"><span>COOK</span></div>
            <div class="nxc-shot" style="background-image:url('{{ 'anm-category-furniture.webp' | asset_url }}')"><span>REST</span></div>
            <div class="nxc-shot" style="background-image:url('{{ 'anm-category-lighting.webp' | asset_url }}')"><span>NIGHT</span></div>
            <div class="nxc-shot" style="background-image:url('{{ 'anm-campsite.jpg' | asset_url }}')"><span>REMEMBER</span></div>
          </div>
        </div>
      </section>

      <section id="nxc-rules" class="nxc-rules nxc-wrap nxc-section">
        <div class="nxc-rules__intro" data-nxc-reveal>
          <p class="nxc-kicker">RULES &amp; JUDGING</p>
          <h2>Keep the adventure wild.<br>Keep the rules simple.</h2>
          <p>Final eligibility, dates and submission requirements are governed by the official Challenge Terms before launch.</p>
        </div>
        <div class="nxc-accordion" data-nxc-reveal>
          <details><summary>How do I join?<span>+</span></summary><p>Choose either the RM150 Adventure Entry or qualify through a RM299+ ANM’s OUTDOORS gear purchase, then follow the official submission brief.</p></details>
          <details><summary>What should my video show?<span>+</span></summary><p>Real outdoor moments: the journey, the people, the place and your own way of telling the story. The final brief will confirm required moments and format.</p></details>
          <details><summary>How is the winner chosen?<span>+</span></summary><p>The challenge is intended to be judged on story, adventure, creativity and natural brand integration, subject to the final official terms.</p></details>
          <details><summary>Can ANM’s OUTDOORS feature my entry?<span>+</span></summary><p>Selected entries may be featured in brand content or campaigns only under the permissions stated in the official Challenge Terms.</p></details>
        </div>
      </section>

      <section class="nxc-final">
        <div class="nxc-final__media" style="background-image:url('{{ 'anm-campsite.jpg' | asset_url }}')" aria-hidden="true"></div>
        <div class="nxc-final__shade" aria-hidden="true"></div>
        <div class="nxc-wrap nxc-final__content" data-nxc-reveal>
          <p class="nxc-kicker">YOUR ADVENTURE. OUR STORY.</p>
          <h2>Your adventure could<br>be the next story.</h2>
          <a class="nxc-btn nxc-btn--gold" href="#nxc-entry">JOIN THE CHALLENGE <span>→</span></a>
        </div>
      </section>
    </main>
  </div>

  <script src="{{ 'challenge-experience.js' | asset_url }}" defer></script>
{% else %}
  <section class="section wrap narrow">
    <h1>{{ page.title | escape }}</h1>
    <div class="richtext">{{ page.content }}</div>
  </section>
{% endif %}

{% schema %}
{"name":"Page","settings":[]}
{% endschema %}