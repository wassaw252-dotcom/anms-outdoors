<section class="section wrap"><span class="eyebrow">{{ 'search.eyebrow' | t }}</span><h1>{{ 'nav.search' | t }}</h1><div class="narrow search-page-form">{% render 'search-form', form_id: 'SearchPage' %}</div>{% if search.performed %}{% paginate search.results by 24 %}<p>{{ 'search.count' | t: count: search.results_count, terms: search.terms | escape }}</p><div class="product-grid">{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', product: result %}{% else %}<article><h2><a href="{{ result.url }}">{{ result.title | escape }}</a></h2></article>{% endif %}{% else %}<div class="empty-state"><h2>{{ 'search.empty' | t }}</h2><p>{{ 'search.try' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'nav.all_gear' | t }}</a></div>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}{% endif %}</section>
{% schema %}
{"name":"Search results","settings":[]}
{% endschema %}
