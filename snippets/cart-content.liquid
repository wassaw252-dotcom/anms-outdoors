{% doc %}
  Server rendered cart contents used by drawer and cart page.
  @param {string} context - Unique identifier for form controls
{% enddoc %}
{% if cart.empty? %}<div class="empty-state">{% render 'icon', name: 'cart' %}<h2>{{ 'cart.empty' | t }}</h2><p>{{ 'cart.empty_copy' | t }}</p><a class="button" href="{{ collections['all-gear'].url | default: routes.all_products_collection_url }}">{{ 'nav.all_gear' | t }} {% render 'icon', name: 'arrow' %}</a></div>{% else %}
<form action="{{ routes.cart_url }}" method="post" id="CartForm-{{ context }}" data-cart-form>
<div class="cart-items">{% for item in cart.items %}<article class="cart-item" data-cart-item data-key="{{ item.key | escape }}"><a class="cart-item-image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '96px' }}{% endif %}</a><div><h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>{% unless item.product.has_only_default_variant %}<p class="small muted">{{ item.variant.title | escape }}</p>{% endunless %}{% if item.selling_plan_allocation %}<p class="small">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}{% for property in item.properties %}{% assign property_start = property.first | slice: 0 %}{% if property.last != blank and property_start != '_' %}<p class="small">{{ property.first | escape }}: {{ property.last | escape }}</p>{% endif %}{% endfor %}<p>{{ item.final_line_price | money_with_currency }}{% if item.original_line_price != item.final_line_price %} <s>{{ item.original_line_price | money_with_currency }}</s>{% endif %}</p>{% for discount in item.line_level_discount_allocations %}<p class="small">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}<label class="sr-only" for="{{ context }}Quantity{{ forloop.index }}">{{ 'product.quantity' | t }} — {{ item.product.title | escape }}</label><div class="quantity-control"><button type="button" class="icon-button" data-cart-delta="-1" aria-label="{{ 'product.decrease' | t }}">−</button><input id="{{ context }}Quantity{{ forloop.index }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}" data-cart-quantity><button type="button" class="icon-button" data-cart-delta="1" aria-label="{{ 'product.increase' | t }}">+</button></div></div><a class="icon-button" href="{{ item.url_to_remove }}" data-cart-remove aria-label="{{ 'cart.remove' | t: title: item.product.title | escape }}">{% render 'icon', name: 'trash' %}</a></article>{% endfor %}</div>
<label for="CartNote-{{ context }}">{{ 'cart.note' | t }}</label><textarea name="note" id="CartNote-{{ context }}" data-cart-note rows="3">{{ cart.note | escape }}</textarea><p class="form-error" role="alert" data-cart-error></p>
<div class="cart-summary">{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} <span>−{{ discount.total_allocated_amount | money }}</span></p>{% endfor %}<p class="subtotal">{{ 'cart.subtotal' | t }}<strong>{{ cart.total_price | money_with_currency }}</strong></p><p class="small muted">{{ 'cart.shipping' | t }}</p><button class="button full" type="submit" name="checkout">{{ 'cart.checkout' | t }} {% render 'icon', name: 'arrow' %}</button><button class="button secondary full cart-update" type="submit" name="update">{{ 'cart.update' | t }}</button>{% if context == 'drawer' %}<a class="text-link" href="{{ routes.cart_url }}">{{ 'cart.view' | t }}</a>{% endif %}</div>
</form>{% endif %}
