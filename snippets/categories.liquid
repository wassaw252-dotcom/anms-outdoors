{% doc %}
  Always-clickable collection links with imagery and icon fallbacks.
  @param {string} [mode] - Layout modifier
{% enddoc %}
{% assign handles = 'tents-shelters,furniture-comfort,sleeping-relaxation,camp-kitchen-dining,lighting-power,hydration-outdoor-living,gear-essentials' | split: ',' %}
{% assign icons = 'tent,chair,sleep,pot,lantern,bottle,pack' | split: ',' %}
{% assign adventure_images = 'anm-category-tents.webp,anm-category-furniture.webp,anm-category-sleeping.webp,anm-category-kitchen.webp,anm-category-lighting.webp,anm-category-hydration.webp,anm-category-gear.webp' | split: ',' %}
{% assign category_mode = mode | default: 'grid' %}
<div class="categories categories--{{ category_mode }}">
{% for category_handle in handles %}
{% assign category = collections[category_handle] %}
{% assign category_key = 'categories.' | append: category_handle %}
{% assign category_url = routes.collections_url | append: '/' | append: category_handle %}
{% if category != blank %}{% assign category_label = category.title %}{% else %}{% assign category_label = category_key | t %}{% endif %}
<a class="category" href="{{ category_url }}">
<span class="category-visual">
{% if category_mode == 'grid' %}
<img src="{{ adventure_images[forloop.index0] | asset_url }}" width="480" height="720" loading="lazy" alt="{{ category_label | escape }}">
{% elsif category != blank and category.image != blank %}
{{ category.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '160, 240, 480', sizes: '(min-width: 990px) 180px, 40vw' }}
{% else %}
{% render 'icon', name: icons[forloop.index0] %}
{% endif %}
</span>
<span class="category-name">{{ category_label | escape }}</span>
<span class="category-arrow">{% render 'icon', name: 'arrow' %}</span>
</a>
{% endfor %}
</div>
